// SPDX-License-Identifier: BSD-3-Clause
/*
 * SM8475 (Snapdragon 8+ Gen 1) is derived from SM8450. Only the blocks that
 * are known to differ and are supported by upstream drivers are described
 * here; everything else is inherited from sm8450.dtsi.
 *
 * Based on the sm8450-mainline community sm8475.dtsi by Danila Tikhonov,
 * reduced to the parts that match upstream bindings.
 */

#include "sm8450.dtsi"

/delete-node/ &usb_1_hsphy;
/delete-node/ &ufs_mem_phy;

&soc {
	/* SM8475 uses an eUSB2 PHY instead of the SM8450 femto PHY */
	usb_1_hsphy: phy@88e3000 {
		compatible = "qcom,sm8475-snps-eusb2-phy",
			     "qcom,sm8550-snps-eusb2-phy";
		reg = <0 0x088e3000 0 0x154>;
		#phy-cells = <0>;

		clocks = <&rpmhcc RPMH_CXO_CLK>;
		clock-names = "ref";

		resets = <&gcc GCC_QUSB2PHY_PRIM_BCR>;

		status = "disabled";
	};

	/* v6 register layout, 0x2000 bytes at 0x1d80000 */
	ufs_mem_phy: phy@1d80000 {
		compatible = "qcom,sm8475-qmp-ufs-phy";
		reg = <0 0x01d80000 0 0x2000>;

		clocks = <&rpmhcc RPMH_CXO_CLK>,
			 <&gcc GCC_UFS_PHY_PHY_AUX_CLK>,
			 <&gcc GCC_UFS_0_CLKREF_EN>;
		clock-names = "ref",
			      "ref_aux",
			      "qref";

		power-domains = <&gcc UFS_PHY_GDSC>;

		resets = <&ufs_mem_hc 0>;
		reset-names = "ufsphy";

		#clock-cells = <1>;
		#phy-cells = <0>;

		status = "disabled";
	};
};

&camcc {
	compatible = "qcom,sm8475-camcc";
};

&dispcc {
	compatible = "qcom,sm8475-dispcc";
};

&gcc {
	compatible = "qcom,sm8475-gcc";
};

&gpucc {
	compatible = "qcom,sm8475-gpucc";
};

&videocc {
	compatible = "qcom,sm8475-videocc";
};
